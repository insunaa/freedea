# Freedea dependency pins — single source of truth.
#
# Sourced by every build entry point: .devcontainer/Dockerfile,
# docker/Dockerfile, bin/build_docker.sh / build_docker.ps1, and the GitHub
# workflows (build.yml also fails on drift against the pins that platformio.ini
# must keep inline, since PlatformIO INI has no file substitution).
# DEPENDENCIES.md documents the rationale for each pin.
#
# Versions only — this file must never contain credentials.

# Firmware/Arduino toolchain
PLATFORMIO_VERSION=6.1.19
PIOARDUINO_VERSION=55.03.37
ARDUINOJSON_VERSION=7.4.2

# Code quality (Ubuntu 26.04 apt ships exactly this clang-format; CI pins via pip)
CLANG_FORMAT_VERSION=21.1.8

# Vendored SDK submodule. The authoritative pin is the superproject gitlink
# (mode 160000 entry in the tree — NOT .gitmodules, which only stores
# path+URL); this mirror makes it visible and CI-checkable. The commit must
# stay reachable from a public ref of the upstream repo. At publication the
# release repo is rebuilt without .git, where the submodule becomes vendored
# files at exactly this commit (see RELEASE_PLAN "Publication model").
FREEINK_SDK_REF=e0fcdb125b9248857c0191628804f6fb84dba1c6

# Pinned upstream reference clones (regeneration inputs, not build deps)
MSMART_REF=d7db53bc470d3751b3f29a5ca2fedacdd4d14b70
LUCIDE_REF=a79b2d1
